<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <appliances>
            <general>
                <enabled>1</enabled>
            </general>
            <delivery>
                <enabled>1</enabled>
                <lead_days>5</lead_days>
                <monday>1</monday>
                <tuesday>1</tuesday>
                <wednesday>1</wednesday>
                <thursday>1</thursday>
                <friday>1</friday>
                <saturday>0</saturday>
                <sunday>0</sunday>
                <holidays></holidays>
                <headline>Earliest {date} if ordered now.</headline>
                <subtext>Your delivery date is not secured until you complete your order.</subtext>
            </delivery>
            <epp>
                <protection_plan_box_title>Protection Plan and Installation Service</protection_plan_box_title>
                <modal_title>Protection Plan</modal_title>
            </epp>
        </appliances>
    </default>
</config>
